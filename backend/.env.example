# Copy this file to .env and adjust as needed. .env is gitignored -- your
# real credentials never leave your machine.

# SQLite (zero setup, good for a quick trial):
#   DATABASE_URL=sqlite:///./taxtrin.db
# PostgreSQL (recommended once you're doing real work against this POC):
#   DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# Create the target database first, e.g.:
#   psql -U postgres -c "CREATE DATABASE taxtrin;"
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/taxtrin

# Secret used to sign JWTs. Generate your own for anything beyond local POC use,
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=poc-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma separated list of origins allowed to call the API (Vite dev server default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
